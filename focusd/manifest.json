{
  "schemaVersion": 1,
  "id": "focusd",
  "name": "Focusd",
  "version": "1.0.0",
  "author": "Bibek Bhusal",
  "license": "MIT",
  "description": "A circular Focusd pomodoro timer for the Omarchy bar.",
  "homepage": "https://github.com/BibekBhusal0/omarchy-focusd",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Focusd",
    "description": "A circular Focusd timer with keyboard-driven controls.",
    "category": "Time",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "icons": {
        "work": "",
        "work-paused": "󰏤",
        "short-break": "",
        "short-break-paused": "󰏤",
        "long-break": "󰒲",
        "long-break-paused": "󰏤"
      }
    },
    "schema": [
      {
        "key": "icons.work",
        "type": "string",
        "label": "Work icon"
      },
      {
        "key": "icons.work-paused",
        "type": "string",
        "label": "Work paused icon"
      },
      {
        "key": "icons.short-break",
        "type": "string",
        "label": "Short break icon"
      },
      {
        "key": "icons.short-break-paused",
        "type": "string",
        "label": "Short break paused icon"
      },
      {
        "key": "icons.long-break",
        "type": "string",
        "label": "Long break icon"
      },
      {
        "key": "icons.long-break-paused",
        "type": "string",
        "label": "Long break paused icon"
      }
    ]
  }
}
