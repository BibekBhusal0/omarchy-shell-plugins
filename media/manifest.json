{
  "schemaVersion": 1,
  "id": "bibek.media",
  "name": "Better Media",
  "version": "1.1.4",
  "author": "Bibek Bhusal",
  "description": "MPRIS media control service with cliamp headless support",
  "preview": {
    "tagline": "Every player, one bar widget",
    "icon": "app/media-note.svg",
    "bullets": [
      ["icons/hugeicons--play.svg", "Play, pause and seek from the bar"],
      ["icons/hugeicons--image.svg", "Album art with progress popup"],
      ["icons/hugeicons--list.svg", "Switch between all active sources"]
    ],
    "shot": "screenshot/media.png"
  },
  "homepage": "https://github.com/BibekBhusal0/omarchy-better-media",
  "kinds": ["service", "bar-widget"],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "omarchy": {
    "clonedFrom": "omarchy.media"
  },
  "barWidget": {
    "displayName": "Better Media",
    "description": "MPRIS now-playing with playback controls, plus cliamp headless",
    "category": "Media",
    "allowMultiple": false
  }
}
